# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# ── OpenAI-compatible provider ────────────────────────────────────────────────
# Replace with your actual key. The key is read at runtime and never stored in
# the database, logs, or reports.
OPENAI_API_KEY=sk-your-key-here

# Override the base URL for OpenAI-compatible endpoints (optional).
# Example for a local Ollama instance: http://localhost:11434/v1
OPENAI_BASE_URL=

# Default model to use when none is specified.
OPENAI_MODEL=gpt-4o-mini

# ── Evaluation Lab settings ───────────────────────────────────────────────────
# Directory where SQLite database and reports are stored.
LLM_EVAL_DATA_DIR=./data

# Maximum number of test cases per dataset.
LLM_EVAL_MAX_CASES=10000

# Default request timeout in seconds.
LLM_EVAL_REQUEST_TIMEOUT=30

# Number of bootstrap resamples for confidence intervals.
LLM_EVAL_BOOTSTRAP_N=2000

# Random seed for reproducible bootstrap sampling.
LLM_EVAL_BOOTSTRAP_SEED=42

# Confidence level for intervals (0–1).
LLM_EVAL_CONFIDENCE_LEVEL=0.95

# ── API server ────────────────────────────────────────────────────────────────
# Host and port for the FastAPI server.
API_HOST=127.0.0.1
API_PORT=8000

# Allowed CORS origins (comma-separated). Restrict in production.
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
